<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.bwmp</groupId>
        <artifactId>sigil</artifactId>
        <version>1.0.0</version> <!-- x-release-please-version -->
    </parent>

    <artifactId>sigil-api</artifactId>
    <name>Sigil API</name>
    <description>Public API for registering custom items, abilities and recipes with Sigil.</description>

    <!--
        MUST NOT depend on Keystone, Adventure, or anything else that gets
        relocated into sigil-plugin's jar.

        A third party compiling against this artifact would resolve
        dev.bwmp.keystone.X, while the shipped Sigil jar contains
        dev.bwmp.sigil.libs.keystone.X - a guaranteed NoClassDefFoundError whose
        message names a class that looks entirely correct. Anything Sigil
        re-exposes publicly is re-declared in this module instead; see
        SigilScheduler.
    -->
    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${spigot.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
