<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.bwmp</groupId>
    <artifactId>sigil</artifactId>
    <version>1.0.0</version> <!-- x-release-please-version -->
    <packaging>pom</packaging>

    <name>Sigil</name>
    <description>Custom items, materials, abilities and recipes for Minecraft servers.</description>

    <licenses>
        <license>
            <name>GNU Lesser General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/lgpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!--
        sigil-api is parented here and depends on nothing but the Bukkit API.
        sigil-plugin is parented to keystone-parent instead, which is what gives
        it shading and relocation; it is only aggregated here.
    -->
    <modules>
        <module>sigil-api</module>
        <module>sigil-plugin</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spigot.version>1.18.2-R0.1-SNAPSHOT</spigot.version>
        <!--
            Currently inert. sigil-plugin is parented to keystone-parent, not to
            this pom, so it inherits keystone.version from THERE - not from
            here. Kept in sync with the parent version above so it cannot state
            something false, but bumping it alone changes nothing; the version
            that matters is the <parent> in sigil-plugin/pom.xml.
        -->
        <keystone.version>1.0.2</keystone.version>
    </properties>

    <distributionManagement>
        <repository>
            <id>nexus-site</id>
            <name>maven-releases</name>
            <url>https://nexus.bwmp.dev/repository/maven-releases/</url>
        </repository>
        <snapshotRepository>
            <id>nexus-site</id>
            <name>maven-snapshots</name>
            <url>https://nexus.bwmp.dev/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <repositories>
        <!--
            Keystone lives here. Note this does NOT help Maven find
            keystone-parent: a parent is resolved before the child's
            repositories are read, so that one has to come from settings.xml or
            a local install. See the Jenkinsfile and the README.
        -->
        <repository>
            <id>bwmp-nexus</id>
            <url>https://nexus.bwmp.dev/repository/maven-public/</url>
        </repository>
        <repository>
            <id>spigotmc</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
